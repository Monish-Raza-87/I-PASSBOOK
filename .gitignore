# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Env / secrets
.env
.env.local

# Node (if added later)
node_modules/

# Generated design-review page — rebuild with tools/build-polish-preview.mjs.
# The *.json sources beside it ARE tracked: they are the offline colour cache
# tools/gen-tokens.mjs reads, so only this build output is ignored.
tools/.cache/polish-preview.html

# Screenshots tools/render-themes.mjs writes. They are EVIDENCE of a render, not
# an input to one: every shot is regenerated from the current source in a few
# seconds, and a checked-in PNG of a page that has since changed is worse than
# none, because it looks like the app.
tools/.cache/theme-shots/

# Throwaway driver scripts and their scratch output — a probe written to answer one
# question about one release, and the .txt files a shell command feeds it. Same
# reasoning as the shots above, one level up: they bake in a localhost URL and a
# hand-written fixture, so they are not a durable test and must not be read as one.
# The suites that DO belong to the repo are tools/smoke-*.mjs, which smoke-all.mjs
# globs. The *.json colour cache beside these stays tracked — tools/gen-tokens.mjs
# reads it.
tools/.cache/*.mjs
tools/.cache/*.txt
tools/.cache/*.log

# Build artifacts
dist/